{
  "name": "lore-studio",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "author": "ElpisHeart",
  "description": "Рабочее пространство для создания вымышленных вселенных",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev --webpack --hostname 0.0.0.0",
    "build": "next build --webpack",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint .",
    "db:migrate": "tsx scripts/migrate.ts",
    "test": "vitest run --config vitest.config.ts",
    "test:prepare": "tsx scripts/prepare-tests.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@xyflow/react": "12.12.0",
    "dotenv": "18.0.9",
    "lucide-react": "1.61.0",
    "next": "16.4.3",
    "ol": "10.11.0",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "0.35.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
